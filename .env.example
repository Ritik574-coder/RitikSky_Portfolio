# MotionFolio environment variables (EXAMPLE)
#
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
#
# The AI terminal is optional. This is the public URL of the separately deployed
# Cloudflare Worker; provider API keys belong only in Worker secrets.
VITE_ASSISTANT_API_URL=

# Optional URL of the separate Cloudflare Worker used by About content cards.
# This is a public endpoint URL; owner credentials stay in Worker secrets.
VITE_CONTENT_API_URL=

# Web3Forms contact form access key. Create one at https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=
